{
  "name": "corner-balancer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:sync": "node scripts/generate-asset-manifest.mjs && node scripts/generate-placeholder-assets.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:validate:release": "node scripts/validate-assets.mjs --mode=release",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run assets:sync && npm run assets:validate && npm run typecheck && vite build",
    "build:release": "npm run assets:sync && npm run assets:validate:release && npm run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "idb-keyval": "^6.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
